{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/website/_tools/claude-ga-hook.mjs\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/website/_tools/claude-ga-hook.mjs\"", "timeout": 30, "statusMessage": "Checking Google Analytics tag..." }
        ]
      }
    ]
  }
}
