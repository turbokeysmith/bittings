# Cloudflare Pages — HTTP response headers for turbokeysmith.com
# (Cloudflare reads this file automatically from the deploy root.)
#
# Speed: Cloudflare's global CDN caches and serves these files from the edge
# automatically, and purges that cache on every deploy — so the big speed win is
# already on. The rules below add a sensible browser cache + security headers.

# Site-wide security headers (safe defaults; no HSTS here — turn HSTS on in the
# Cloudflare dashboard once you've confirmed HTTPS works, so it's reversible).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Static assets (logo, CSS, images). Not fingerprinted and still iterating, so keep
# the browser cache SHORT so style/script updates show without a hard refresh.
# (Bump this back up at go-live once the design is stable.)
/assets/*
  Cache-Control: public, max-age=300, must-revalidate

# Bittings staff app (published under /staff/ — private tool, not a site page)
/staff/*
  ! Permissions-Policy
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: geolocation=(self), microphone=(), camera=(self)
  Cache-Control: no-cache
  # never keep the staff app at the Cloudflare edge — updates must show on the next load
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
